# ─────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill in your own values.
#
#   Windows:  copy .env.example .env
#   Mac/Linux:  cp .env.example .env
#
# The .env file holds your passwords and keys. It is in
# .gitignore, so it never gets uploaded. Never share it.
# Put values straight after the "=" with no quotes and no spaces.
# ─────────────────────────────────────────────────────────────


# ── REQUIRED: the Instagram account that posts ───────────────
# Just the handle, without the "@".
# Tip: use a spare account, not your main one.
# After filling these in, run "python setup_instagram.py" once.
INSTAGRAM_USERNAME=your_instagram_handle
INSTAGRAM_PASSWORD=your_instagram_password


# ── STRONGLY RECOMMENDED: Google Gemini ──────────────────────
# This is the brain. It writes the captions, writes the slide
# text, draws the pictures, and brainstorms new topics.
# Free key: https://aistudio.google.com/apikey
#
# Without it the program still runs, but you get plain template
# captions and plain gradient backgrounds instead of AI pictures.
GEMINI_API_KEY=your_gemini_api_key_here


# ── NEEDED ONLY FOR TOPIC MODE: Perplexity ───────────────────
# Used when you run with --perplexity "some topic", and by
# automate.py for every scheduled post.
# Not needed if you only ever pass YouTube links.
# Key: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key_here


# ── OPTIONAL: which Gemini image model to use ────────────────
# Leave this alone unless you know you want something else.
IMAGEN_MODEL=gemini-2.5-flash-image


# ── OPTIONAL: Discord notifications ──────────────────────────
# Get a message in a Discord channel each time a post goes out.
# Discord > Channel Settings > Integrations > Webhooks > New.
# Leave blank to turn Discord alerts off.
DISCORD_WEBHOOK_URL=


# ── OPTIONAL: email notifications ────────────────────────────
# Leave all three blank to turn email alerts off.
# For Gmail, SMTP_PASSWORD must be an "App Password", NOT your
# normal password: https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=

# Mail server settings. The defaults below are for Gmail;
# change them only if you use a different email provider.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
